<% content_for :title, "チームスキル・コックピット" %>

<div class="min-h-screen bg-slate-100">
  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-screen-2xl px-4 py-6 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold text-blue-700">
        Skill Management
      </p>

      <h1 class="mt-1 text-2xl font-bold tracking-tight text-slate-950">
        チームスキル・コックピット
      </h1>

      <p class="mt-2 text-sm text-slate-600">
        チームのスキル構成、育成機会、属人化リスクを確認できます。
      </p>
    </div>
  </header>

  <main class="mx-auto max-w-screen-2xl px-4 py-6 sm:px-6 lg:px-8">
    <%= turbo_frame_tag "cockpit",
          data: { turbo_action: "advance" } do %>

      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <%= form_with url: root_path,
              method: :get,
              data: { turbo_frame: "cockpit" },
              class: "grid gap-4 md:grid-cols-4" do |form| %>

          <div>
            <%= form.label :team_id,
                  "チーム",
                  class: "block text-sm font-medium text-slate-700" %>

            <%= form.collection_select :team_id,
                  @teams,
                  :id,
                  :name,
                  {
                    selected: @selected_team&.id
                  },
                  {
                    class: "mt-1 w-full rounded-lg border-slate-300"
                  } %>
          </div>

          <div>
            <%= form.label :category_id,
                  "カテゴリ",
                  class: "block text-sm font-medium text-slate-700" %>

            <%= form.collection_select :category_id,
                  @categories,
                  :id,
                  :name,
                  {
                    include_blank: "すべてのカテゴリ",
                    selected: params[:category_id]
                  },
                  {
                    class: "mt-1 w-full rounded-lg border-slate-300"
                  } %>
          </div>

          <div>
            <%= form.label :query,
                  "スキル検索",
                  class: "block text-sm font-medium text-slate-700" %>

            <%= form.search_field :query,
                  value: params[:query],
                  placeholder: "Rails、AWSなど",
                  class: "mt-1 w-full rounded-lg border-slate-300" %>
          </div>

          <div class="flex items-end">
            <%= form.submit "絞り込む",
                  class: "w-full cursor-pointer rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white hover:bg-blue-800" %>
          </div>
        <% end %>
      </section>

      <section class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <%= render "summary_card",
              label: "メンバー",
              value: "#{@member_count}人",
              description: @selected_team&.name || "チーム未登録" %>

        <%= render "summary_card",
              label: "登録スキル",
              value: "#{@registered_skill_count}件",
              description: "チーム内で登録済み" %>

        <%= render "summary_card",
              label: "更新要確認",
              value: "#{@stale_employee_count}人",
              description: "180日以上更新されていない情報あり" %>

        <%= render "summary_card",
              label: "属人化リスク",
              value: "#{@dependency_risk_count}件",
              description: "実務対応可能者が1人のみ" %>
      </section>

      <div class="mt-6 grid gap-6 lg:grid-cols-4">
        <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm lg:col-span-3">
          <div class="border-b border-slate-200 px-5 py-4">
            <h2 class="font-semibold text-slate-950">
              チームスキルマップ
            </h2>

            <p class="mt-1 text-sm text-slate-500">
              数字は現在レベル、実務は実務経験ありを表します。
            </p>
          </div>

          <% if @employees.any? && @skills.any? %>
            <div class="overflow-x-auto">
              <table class="min-w-full border-collapse">
                <thead>
                  <tr class="bg-slate-50">
                    <th class="sticky left-0 z-10 min-w-48 border-b border-r border-slate-200 bg-slate-50 px-4 py-3 text-left text-sm font-semibold text-slate-700">
                      メンバー
                    </th>

                    <% @skills.each do |skill| %>
                      <th class="min-w-28 border-b border-slate-200 px-3 py-3 text-center">
                        <span class="block text-xs font-medium text-slate-500">
                          <%= skill.skill_category.name %>
                        </span>

                        <span class="mt-1 block text-sm font-semibold text-slate-900">
                          <%= skill.name %>
                        </span>

                        <% if skill.important? %>
                          <span class="mt-1 inline-block rounded-full bg-rose-100 px-2 py-0.5 text-xs text-rose-700">
                            重要
                          </span>
                        <% end %>
                      </th>
                    <% end %>
                  </tr>
                </thead>

                <tbody>
                  <% @employees.each do |employee| %>
                    <tr class="border-b border-slate-100 last:border-b-0">
                      <th class="sticky left-0 z-10 border-r border-slate-200 bg-white px-4 py-4 text-left">
                        <span class="block font-semibold text-slate-900">
                          <%= employee.name %>
                        </span>

                        <span class="mt-1 block text-xs font-normal text-slate-500">
                          <%= employee.role.presence || "役割未登録" %>
                        </span>
                      </th>

                      <% @skills.each do |skill| %>
                        <% employee_skill =
                             @employee_skill_map[
                               [employee.id, skill.id]
                             ] %>

                        <td class="px-3 py-3">
                          <div class="<%= skill_level_classes(employee_skill&.current_level) %>">
                            <% if employee_skill %>
                              <span class="text-lg font-bold">
                                <%= employee_skill.current_level %>
                              </span>

                              <span class="mt-1 text-xs">
                                <% if employee_skill.practical_experience? %>
                                  実務
                                <% else %>
                                  学習
                                <% end %>
                              </span>

                              <% if employee_skill.updated_at < 180.days.ago %>
                                <span class="mt-1 text-xs font-semibold text-rose-700">
                                  更新要確認
                                </span>
                              <% elsif employee_skill.manager_verified? %>
                                <span class="mt-1 text-xs">
                                  確認済み
                                </span>
                              <% end %>
                            <% else %>
                              <span class="text-sm">
                                未登録
                              </span>
                            <% end %>
                          </div>
                        </td>
                      <% end %>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="px-6 py-16 text-center">
              <p class="font-medium text-slate-700">
                条件に該当するデータがありません
              </p>

              <p class="mt-1 text-sm text-slate-500">
                チームまたは検索条件を変更してください。
              </p>
            </div>
          <% end %>
        </section>

        <aside class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="font-semibold text-slate-950">
            詳細パネル
          </h2>

          <p class="mt-3 text-sm leading-6 text-slate-600">
            次の工程で、メンバー名またはスキル名を選択すると、
            この領域だけがHotwireで更新されるようにします。
          </p>
        </aside>
      </div>

      <p class="mt-6 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
        スキル情報は育成・配置・対話を支援するための情報です。
        単独で人事評価を決定するものではありません。
      </p>
    <% end %>
  </main>
</div>